# Project URL from Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# service_role — never the anon/publishable key, never commit this file
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional local fallback if Vault secret wb_token_<slug> is not set yet
# Name must match sellers.slug: slug "main" → WB_TOKEN_MAIN
WB_TOKEN_MAIN=

# History backfill start (ISO date). Used when enqueueing history jobs.
HISTORY_FROM=2026-03-01

# Telegram daily digest (BotFather token + chat_id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
